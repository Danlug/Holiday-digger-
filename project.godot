; Engine configuration file.
; Раскопки на каникулах

config_version=5

[application]

config/name="Раскопки на каникулах"
config/description="Пиксельная RPG-idle про раскопки"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="1.0"
boot_splash/bg_color=Color(0.050980, 0.039216, 0.027451, 1)
boot_splash/image="res://art/ui/brand/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=false
config/icon="res://art/ui/brand/icon.png"

[autoload]

Balance="*res://scripts/core/balance.gd"
GameState="*res://scripts/core/game_state.gd"
DayCycle="*res://scripts/core/day_cycle.gd"
IAPManager="*res://scripts/core/iap_manager.gd"
AdManager="*res://scripts/core/ad_manager.gd"

[display]

window/size/viewport_width=224
window/size/viewport_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
