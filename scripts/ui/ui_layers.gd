class_name UiLayers
extends RefCounted
## Порядок слоёв экрана (CanvasLayer.layer) — один на всю игру (ГДД §16):
##
##   мир (0) < HUD и его виджеты (HUD…HUD_TOP) < окна (HUD_WINDOWS и выше) < тосты и подсказки
##
## Виджет HUD со своим CanvasLayer (трекер проекта, бак бура и термометр, шкала
## азарта, боевые кнопки, пузыри «Зайти»/«В бурмобиль», курьер) берёт слой из
## HUD…HUD_TOP; окно — не ниже HUD_WINDOWS. Окна самого HUD (рюкзак, настройки,
## меню «•••») живут на слое HUD_WINDOWS, а не в слое HUD: раньше любой виджет со
## своим слоем светился поверх открытого рюкзака (владелец 26.10: «штука с буром
## светится поверх других менюшек»). Проверяет tests/test_hud_layers.gd.

const WORLD := 0
const HUD := 1            # сам HUD (main.gd); дрожь жары — тем же слоем, раньше него в дереве
const HUD_WIDGETS := 2    # трекер проекта, бак бура и термометр, шкала азарта
const HUD_TOP := 10       # выше HUD-виджету нельзя (курьер доставки — 10)
const HUD_WINDOWS := 11   # рюкзак, настройки, меню «•••»: над виджетами, под складом (12) и мастерской (20)
## Остальная лестница снизу вверх; одинаковые номера — порядок решает дерево.
const COMBAT_HUD := 3     # боевые кнопки
const WORLD_BUBBLES := 8  # пузыри над миром: «Зайти», «В бурмобиль», «Вниз», дверь лавки, могила, жар
const HOUSE := 9          # интерьер дома: над пузырями, под курьером (HUD_TOP)
const STORAGE := 12       # склад дома
const SHEETS := 20        # шторка лавки и мастерской: перекрывает джойстик и нижнюю полосу
const PROMPTS := 30       # окно количества в доме, дневник
const HINTS := 40         # подсказка-оверлей
const HINT_MARKS := 41    # метки подсказок
const HURT := 57          # красная кромка урона: над окнами, под вспышкой Fx
const FX_FLASH := 58      # общая вспышка экрана
const FX_FLY := 59        # летящие иконки и монеты
const SPOTLIGHT := 60     # затемнение урока: над витриной и подсказками
const PREMIUM_FX := 61    # разгрузка премиум-товара: над летящими монетами
const BANNER := 90        # баннер автокопки: над всем игровым, под мета-окнами
const META := 92          # хаб наград, журнал, экипировка
const MODAL := 93         # задания дня, серия новичка, проекты
const DEATH := 93         # окно смерти: тост ждёт его закрытия (meta_toast), Tip гаснет при открытии
const DAILY := 94         # подарок дня, экран техники
const HERO := 95          # экран героя
const HERO_CARD := 96     # карточка поверх экрана героя, отчёт скважины
const TOAST := 97         # тост наград сверху (meta_toast)
const META_FX := 98       # искры наград
const CUTSCENE := 100     # катсцена
const CONSENT := 110      # окно согласия на аналитику: над всем, кроме Tip
const TIP := 128          # подсказка Tip — над всем
## Группа слоёв HUD_WIDGETS: HUD прячет их вместе с собой (диалог сюжета, дом), см. hud.gd
const WIDGETS_GROUP := &"hud_widget_layer"
