shader_type canvas_item;
// Чёткий пиксель-арт при любом масштабе, наклоне и дробном сдвиге.
//
// Ближайший сосед при нецелом масштабе даёт пиксели разной ширины и рвёт
// наклонённый край лесенкой; линейный фильтр мылит весь рисунок. Здесь
// внутри пикселя рисунка цвет берётся ровно из его центра, а смешение
// соседей остаётся только на их границе шириной в один экранный пиксель
// (fwidth) — края гладкие, середина чёткая. Нужен линейный фильтр текстуры.
//
// cell — сколько текселей в пикселе рисунка: у перерисованного мальчика 2
// (tools/gen_hero_art.py), у авторских листов 1.

uniform float cell = 1.0;

// В fragment() COLOR уже умножен на текстуру — цвет вершины (modulate) берём
// отсюда, иначе текстура легла бы дважды.
varying vec4 modulate;

void vertex() {
	modulate = COLOR;
}

void fragment() {
	vec2 size = vec2(textureSize(TEXTURE, 0)) / cell;
	vec2 p = UV * size;
	vec2 seam = floor(p + 0.5);
	vec2 w = max(fwidth(p), vec2(1e-4));
	p = seam + clamp((p - seam) / w, -0.5, 0.5);
	COLOR = texture(TEXTURE, p / size) * modulate;
}
